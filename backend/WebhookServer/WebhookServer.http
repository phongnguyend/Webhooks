@WebhookServer_HostAddress = http://localhost:5229
@tenantId = replace-after-creation
@topicId = replace-after-creation

GET {{WebhookServer_HostAddress}}/healthz
Accept: application/json

###

GET {{WebhookServer_HostAddress}}/api/tenants
Accept: application/json

###

POST {{WebhookServer_HostAddress}}/api/tenants
Content-Type: application/json

{
  "name": "Demo tenant",
  "isEnabled": true
}

###

POST {{WebhookServer_HostAddress}}/api/tenants/{{tenantId}}/topics
Content-Type: application/json

{
  "key": "orders",
  "name": "Order events",
  "isEnabled": true,
  "isSharePointWebhook": false,
  "useManagedIdentity": true,
  "fullyQualifiedNamespace": "my-namespace.servicebus.windows.net",
  "serviceBusConnectionString": null,
  "serviceBusEntityName": "incoming-orders",
  "serviceBusEntityType": "Topic"
}

###

POST {{WebhookServer_HostAddress}}/tenants/{{tenantId}}/topics/orders
Content-Type: application/json

{
  "orderId": "ORD-1042",
  "status": "paid"
}

###

PATCH {{WebhookServer_HostAddress}}/api/tenants/{{tenantId}}/topics/{{topicId}}/enabled
Content-Type: application/json

{
  "isEnabled": false
}
