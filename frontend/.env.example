# Copy to .env.local and restart Vite after changing values.
# VITE_ values are public in the browser. Never put client secrets or JWT signing keys here.
VITE_API_URL=http://localhost:5229

# Google OAuth web client ID; must match backend Authentication__Google__ClientId.
VITE_GOOGLE_CLIENT_ID="<google-client-id>.apps.googleusercontent.com"
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/

# Optional Microsoft sign-in: set both IDs to enable the button, or leave both empty.
# Use the sign-in app registration client ID and a specific directory tenant GUID,
# not the GitHub deployment managed identity or common/organizations.
# Match backend Authentication__Microsoft__ClientId and Authentication__Microsoft__TenantId.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
# Register this exact URI under the Microsoft app's Single-page application platform.
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/

# For Azure, use the deployed API URL and frontend redirect URLs (including trailing /).
# The release workflow supplies these values at build time.
