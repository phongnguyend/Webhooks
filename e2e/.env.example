# Use dedicated local/dev/test accounts, never production.
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:5229
# Enabled Identity accounts with AllowPasswordAuthentication on, passwords and no MFA.
# USER must have User role only; ADMIN must have Global Admin role.
E2E_USER_USERNAME=user@e2e.test
E2E_USER_PASSWORD=
E2E_ADMIN_USERNAME=admin@e2e.test
E2E_ADMIN_PASSWORD=
